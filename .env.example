# ============================================================
# AGENTE DE VENTAS · VARIABLES DE ENTORNO
# Copia este archivo como .env y completa tus valores.
#
# El perfil del negocio y el catálogo (productos y servicios)
# NO van aquí: van en config/negocio.json
# (parte de un ejemplo en negocios/ejemplos/).
#
# WhatsApp va por BAILEYS: no hace falta Evolution API, ngrok
# ni ningún webhook público. El número se conecta escaneando
# un QR desde el puente (baileys-bridge/).
# ============================================================

# ------------------------------------------------------------
# PUENTE DE WHATSAPP (BAILEYS)   -> baileys-bridge/
# ------------------------------------------------------------
# Dónde escucha el motor (suele dejarse igual)
AGENT_URL=http://127.0.0.1:8000

# Token compartido entre el puente y el motor (recomendado en producción).
# Si lo defines, el puente lo envía y el motor lo exige en /mensaje.
BRIDGE_TOKEN=

# Panel del puente: aquí ves el QR para vincular el WhatsApp
BRIDGE_PORT=3001
BRIDGE_HOST=0.0.0.0

# Carpeta donde se guarda la sesión (no la subas al repositorio)
BAILEYS_AUTH_DIR=baileys-bridge/auth
BAILEYS_DEVICE_NAME=Agente de Ventas
# silencioso | error | warn | info | debug
BAILEYS_LOG_LEVEL=warn

# Comportamiento
RESPOND_TO_GROUPS=false          # responder en grupos (por defecto no)
PERMITIR_MIS_MENSAJES=false      # true: también responde a tus propios mensajes (útil para probar solo)
ENVIAR_LEIDO=true                # marcar como leído
SEND_PRESENCE=true               # mostrar "escribiendo…"
DELAY_ENTRE_RESPUESTAS_MS=900    # pausa entre mensajes
DESCARGAR_MEDIA=true             # descargar audios/imágenes para poder transcribir
MAX_MEDIA_MB=16

# ------------------------------------------------------------
# IA (OPCIONAL)
# El agente responde igual sin IA: usa el catálogo del negocio.
# AI_PROVIDER: auto | gemini | openai | ollama | rules
# ------------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=auto
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3
AI_TIMEOUT=25
# Transcripción de notas de voz (usa OpenAI Whisper)
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=es

# ------------------------------------------------------------
# NEGOCIO
# ------------------------------------------------------------
BUSINESS_CONFIG=config/negocio.json

# ------------------------------------------------------------
# COMPORTAMIENTO DE LAS RESPUESTAS
# ------------------------------------------------------------
MAX_RESPONSE_LENGTH=900       # largo máximo de cada respuesta
MAX_ITEMS_IN_REPLY=5          # cuántos productos/servicios listar
MATCH_THRESHOLD=0.42          # qué tan exigente es al reconocer un ítem
CONTEXT_WINDOW_LENGTH=10      # turnos de conversación que recuerda

# A quién le llegan los avisos (citas, cotizaciones, quejas, cliente pide humano).
# Escríbelo con indicativo de país y sin signos: 573001112233
HUMAN_ESCALATION_NUMBER=

# ------------------------------------------------------------
# SERVIDOR Y LOGS
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FILE=logs/agente_ventas.log
TEMP_DIR=temp
WEBHOOK_TOKEN=                # token opcional para proteger /mensaje y /webhook
